# ==============================================================================
# FocusDNA AI — Production Environment Variables Template (.env.example)
# ==============================================================================
# DO NOT COMMIT REAL PRODUCTION SECRETS TO GIT REPOSITORIES.
# Copy this file to .env and fill in production secrets during deployment.

# ------------------------------------------------------------------------------
# 1. NEXT.JS FRONTEND ENVIRONMENT VARIABLES (apps/web)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
NEXT_PUBLIC_API_URL=https://api.focusdna.ai

# ------------------------------------------------------------------------------
# 2. FASTAPI BACKEND ENVIRONMENT VARIABLES (apps/api)
# ------------------------------------------------------------------------------
ENVIRONMENT=production
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://focusdna.ai,https://app.focusdna.ai

# Supabase Production Database Credentials
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Google Gemini AI API Key (Backend Only - NEVER expose to frontend)
GEMINI_API_KEY=AIzaSyB...

# JWT Authentication Secret (For standalone backend verification)
JWT_SECRET_KEY=your_secure_random_256_bit_jwt_secret_key_here

# ------------------------------------------------------------------------------
# 3. CHROME EXTENSION & DESKTOP AGENT CONFIGURATION
# ------------------------------------------------------------------------------
CHROME_EXTENSION_API_BASE=https://api.focusdna.ai
DESKTOP_AGENT_API_BASE=https://api.focusdna.ai
